{
  "version": 2,
  "name": "yarnix-labs",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {},
  "env": {
    "VITE_SANITY_PROJECT_ID": "v7q2gijs",
    "VITE_SANITY_DATASET": "production",
    "VITE_SANITY_API_VERSION": "2024-03-19"
  }
}
